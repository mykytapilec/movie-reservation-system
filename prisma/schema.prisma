generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  description String?
  duration    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  showtimes Showtime[]
}

model Auditorium {
  id       String @id @default(uuid())
  name     String
  capacity Int

  seats     Seat[]
  showtimes Showtime[]
}

model Seat {
  id           String @id @default(uuid())
  row          String
  number       Int

  auditoriumId String
  auditorium   Auditorium @relation(fields: [auditoriumId], references: [id], onDelete: Cascade)

  reservations Reservation[]

  @@unique([auditoriumId, row, number])
}

model Showtime {
  id           String   @id @default(uuid())
  startTime    DateTime

  movieId      String
  movie        Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  auditoriumId String
  auditorium   Auditorium @relation(fields: [auditoriumId], references: [id], onDelete: Cascade)

  reservations Reservation[]
}

model Reservation {
  id           String   @id @default(uuid())
  customerName String
  createdAt    DateTime @default(now())

  seatId       String
  seat         Seat @relation(fields: [seatId], references: [id], onDelete: Cascade)

  showtimeId   String
  showtime     Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  @@unique([seatId, showtimeId])
}